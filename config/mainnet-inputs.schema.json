{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bit.invalid/schemas/mainnet-inputs-v1.json",
  "title": "BIT mainnet external inputs v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "network_type", "mainnet_ready", "status", "identity",
    "genesis_manifest_hash", "genesis_signature_package_sha256",
    "genesis_derived_manifest_sha256", "genesis_derived_signature_package_sha256",
    "derived_genesis", "initial_supply_state", "checkpoint_publishers",
    "independent_endpoints", "external_security_reviews",
    "platform_signing_certificates", "release_artifacts"
  ],
  "properties": {
    "network_type": { "const": "mainnet" },
    "mainnet_ready": { "type": "boolean" },
    "status": { "type": "string", "minLength": 1 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id", "genesis_time_unix_seconds", "source_commit",
        "crypto_manifest_sha256", "consensus_parameters_sha256",
        "native_asset_id", "key_derivation_version", "address_encoding_version",
        "resource_limits", "monetary_policy", "allocations", "genesis_claims",
        "genesis_commitments", "initial_validators", "approval_policy"
      ],
      "properties": {
        "chain_id": { "$ref": "#/$defs/nullableString" },
        "genesis_time_unix_seconds": { "$ref": "#/$defs/nullablePositiveInteger" },
        "source_commit": { "anyOf": [{ "$ref": "#/$defs/lowerHex40" }, { "$ref": "#/$defs/lowerHex64" }, { "type": "null" }] },
        "crypto_manifest_sha256": { "$ref": "#/$defs/nullableHash" },
        "consensus_parameters_sha256": { "$ref": "#/$defs/nullableHash" },
        "native_asset_id": { "$ref": "#/$defs/nullableHash" },
        "key_derivation_version": { "$ref": "#/$defs/nullableString" },
        "address_encoding_version": { "$ref": "#/$defs/nullableString" },
        "resource_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_version", "max_block_bytes", "max_tx_lifetime_blocks", "max_envelope_bytes", "anchor_retention_blocks"],
          "properties": {
            "protocol_version": { "$ref": "#/$defs/nullablePositiveInteger" },
            "max_block_bytes": { "$ref": "#/$defs/nullablePositiveInteger" },
            "max_tx_lifetime_blocks": { "$ref": "#/$defs/nullablePositiveInteger" },
            "max_envelope_bytes": { "$ref": "#/$defs/nullablePositiveInteger" },
            "anchor_retention_blocks": { "$ref": "#/$defs/nullablePositiveInteger" }
          }
        },
        "monetary_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy_id", "max_supply_atomic", "decimals", "genesis_supply_atomic", "epoch_blocks", "halving_interval_epochs", "empty_set_policy", "burn_reopens_issuance", "tail_emission_enabled", "monetary_policy_hash"],
          "properties": {
            "policy_id": { "const": "BUDGET_HALVING_EPOCH_V1" },
            "max_supply_atomic": { "const": "10240000000000000000" },
            "decimals": { "const": 8 },
            "genesis_supply_atomic": { "$ref": "#/$defs/nullableAmount" },
            "epoch_blocks": { "$ref": "#/$defs/nullablePositiveInteger" },
            "halving_interval_epochs": { "$ref": "#/$defs/nullablePositiveInteger" },
            "empty_set_policy": { "const": "FORFEIT_UNISSUED_NO_CATCHUP" },
            "burn_reopens_issuance": { "const": false },
            "tail_emission_enabled": { "const": false },
            "monetary_policy_hash": { "$ref": "#/$defs/nullableHash" }
          }
        },
        "allocations": { "type": "array", "items": { "$ref": "#/$defs/allocation" } },
        "genesis_claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "genesis_commitments": { "type": "array", "items": { "$ref": "#/$defs/commitment" } },
        "initial_validators": { "type": "array", "items": { "$ref": "#/$defs/validator" } },
        "approval_policy": {
          "type": "object", "additionalProperties": false,
          "required": ["threshold", "signers"],
          "properties": {
            "threshold": { "$ref": "#/$defs/nullablePositiveInteger" },
            "signers": { "type": "array", "items": { "$ref": "#/$defs/lowerHex64" }, "uniqueItems": true }
          }
        }
      }
    },
    "genesis_manifest_hash": { "$ref": "#/$defs/nullableHash" },
    "genesis_signature_package_sha256": { "$ref": "#/$defs/nullableHash" },
    "genesis_derived_manifest_sha256": { "$ref": "#/$defs/nullableHash" },
    "genesis_derived_signature_package_sha256": { "$ref": "#/$defs/nullableHash" },
    "derived_genesis": {
      "type": "object", "additionalProperties": false,
      "required": ["derived_manifest_hash", "runtime_inputs_sha256", "shielded_tree_root", "app_hash", "genesis_execution_hash", "genesis_compact_hash", "cometbft_genesis_sha256"],
      "properties": {
        "derived_manifest_hash": { "$ref": "#/$defs/nullableHash" },
        "runtime_inputs_sha256": { "$ref": "#/$defs/nullableHash" },
        "shielded_tree_root": { "$ref": "#/$defs/nullableHash" },
        "app_hash": { "$ref": "#/$defs/nullableHash" },
        "genesis_execution_hash": { "$ref": "#/$defs/nullableHash" },
        "genesis_compact_hash": { "$ref": "#/$defs/nullableHash" },
        "cometbft_genesis_sha256": { "$ref": "#/$defs/nullableHash" }
      }
    },
    "initial_supply_state": {
      "type": "object", "additionalProperties": false,
      "required": ["cumulative_minted_atomic", "burned_atomic", "forfeited_unissued_atomic", "completed_epochs", "future_budget_atomic"],
      "properties": {
        "cumulative_minted_atomic": { "const": "0" },
        "burned_atomic": { "const": "0" },
        "forfeited_unissued_atomic": { "const": "0" },
        "completed_epochs": { "const": 0 },
        "future_budget_atomic": { "$ref": "#/$defs/nullableAmount" }
      }
    },
    "checkpoint_publishers": { "type": "array" },
    "independent_endpoints": { "type": "array" },
    "external_security_reviews": { "type": "array" },
    "platform_signing_certificates": { "type": "array" },
    "release_artifacts": { "type": "array", "items": { "$ref": "#/$defs/releaseArtifact" } }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"], "minLength": 1 },
    "nullablePositiveInteger": { "type": ["integer", "null"], "minimum": 1 },
    "nullableHash": { "anyOf": [{ "$ref": "#/$defs/lowerHex64" }, { "type": "null" }] },
    "lowerHex40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "lowerHex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableAmount": { "anyOf": [{ "type": "string", "pattern": "^(0|[1-9][0-9]{0,36})$" }, { "type": "null" }] },
    "allocation": {
      "type": "object", "additionalProperties": false,
      "required": ["allocation_id", "kind", "amount_atomic"],
      "properties": {
        "allocation_id": { "$ref": "#/$defs/lowerHex64" },
        "kind": { "enum": ["GENESIS_CLAIM", "SHIELDED_COMMITMENT", "VALIDATOR_SELF_BOND", "FEE_RESERVE"] },
        "amount_atomic": { "type": "string", "pattern": "^[1-9][0-9]{0,36}$" }
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["allocation_id", "claim_pubkey"],
      "properties": {
        "allocation_id": { "$ref": "#/$defs/lowerHex64" },
        "claim_pubkey": { "$ref": "#/$defs/lowerHex64" }
      }
    },
    "commitment": {
      "type": "object", "additionalProperties": false,
      "required": ["allocation_id", "commitment"],
      "properties": {
        "allocation_id": { "$ref": "#/$defs/lowerHex64" },
        "commitment": { "$ref": "#/$defs/lowerHex64" }
      }
    },
    "validator": {
      "type": "object", "additionalProperties": false,
      "required": ["allocation_id", "operator_pubkey", "consensus_pubkey", "owner_pubkey", "commission_bps"],
      "properties": {
        "allocation_id": { "$ref": "#/$defs/lowerHex64" },
        "operator_pubkey": { "$ref": "#/$defs/lowerHex64" },
        "consensus_pubkey": { "$ref": "#/$defs/lowerHex64" },
        "owner_pubkey": { "$ref": "#/$defs/lowerHex64" },
        "commission_bps": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "releaseArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/lowerHex64" }
      }
    }
  }
}
